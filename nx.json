{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "parallel": 5,
  "tui": {
    "enabled": false
  },
  "targetDefaults": {
    "dev": {
      "dependsOn": ["^build"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "cache": false
    },
    "preview": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "clean": {
      "dependsOn": ["^clean"],
      "cache": false
    }
  },
  "cli": {
    "packageManager": "pnpm"
  },
  "release": {
    "projects": ["zudoku", "create-zudoku"],
    "versionPlans": true,
    "version": {
      "adjustSemverBumpsForZeroMajorVersion": false,
      "git": {
        "commitMessage": "chore(release): publish {version} [skip ci]"
      }
    },
    "changelog": {
      "git": {
        "commit": false,
        "tag": false
      },
      "projectChangelogs": false,
      "workspaceChangelog": {
        "file": false,
        "createRelease": "github",
        "renderOptions": {
          "authors": false,
          "commitReferences": true,
          "versionTitleDate": true
        }
      }
    },
    "releaseTag": {
      "pattern": "v{version}"
    }
  },
  "neverConnectToCloud": true,
  "analytics": false
}
