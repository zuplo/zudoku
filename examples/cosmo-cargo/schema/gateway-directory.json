    "/v1/servers/{serverId}": {
      "get": {
        "tags": ["Gateway Directory"],
        "summary": "Get one MCP server",
        "description": "Returns a single server with its tool list, required scopes, data residency, and the teams it is currently granted to. Use this before filing an access request so the justification names the scopes you actually need.",
        "operationId": "getMcpServer",
        "security": [
          {
            "CrewSSO": ["directory:read"]
          }
        ],
        "parameters": [
          {
            "name": "serverId",
            "in": "path",
            "required": true,
            "description": "Server identifier, e.g. `cosmo-workday-hcm`.",
            "schema": {
              "type": "string"
            },
            "example": "cosmo-salesforce-sales-cloud"
          }
        ],
        "responses": {
          "200": {
            "description": "Server detail.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerDetail"
                },
                "example": {
                  "id": "cosmo-salesforce-sales-cloud",
                  "displayName": "Salesforce Sales Cloud",
                  "domain": "CRM & Customer Operations",
                  "endpoint": "https://mcp.cosmocargo.space/v1/salesforce/sales-cloud/mcp",
                  "authType": "sso",
                  "toolCount": 6,
                  "scopes": [
                    "mcp:read",
                    "mcp:write",
                    "salesforce.crm:read",
                    "salesforce.crm:write"
                  ],
                  "description": "Pipeline, account, and activity data for the freight sales org. Every session is pinned to the crew member's own Salesforce user, so record visibility follows the sharing rules already configured in Sales Cloud — an account executive on the Outer Rim desk sees the Outer Rim book and nothing more.\n\nWrites are scoped to opportunities, tasks, and activity logging. Quote approvals, contract terms, and anything that moves revenue recognition stay in Salesforce behind their existing approval processes.",
                  "tools": [
                    {
                      "name": "soql_query",
                      "description": "Run a read-only SOQL query against Sales Cloud. Statements are rewritten to add a LIMIT and rejected if they contain DML."
                    },
                    {
                      "name": "get_account",
                      "description": "Fetch a single account with its owner, shipping tier, and open opportunity count."
                    },
                    {
                      "name": "list_opportunities",
                      "description": "List opportunities filtered by owner, stage, or close date."
                    },
                    {
                      "name": "update_opportunity",
                      "description": "Update stage, amount, or next step on an opportunity the caller owns. At least one of `stage`, `amount`, or `nextStep` must be supplied."
                    },
                    {
                      "name": "create_task",
                      "description": "Create a follow-up task against an account, contact, or opportunity."
                    },
                    {
                      "name": "log_activity",
                      "description": "Log a call or meeting summary to the activity timeline."
                    }
                  ],
                  "grantedTo": [
                    "Freight Sales",
                    "Revenue Operations",
                    "Crew Enablement"
                  ],
                  "dataResidency": "sol-primary",
                  "lastReviewed": "3024-11-02"
                }
              }
            }
          },
          "404": {
            "description": "No such server in the directory.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/access-requests": {
      "post": {
        "tags": ["Gateway Directory"],
        "summary": "Request access to a server",
        "description": "Files an access request for a server and scope set. Requests route to the caller's manager and, for anything in the Finance, HR & Procurement domain, to the data owner as a second approver.\n\nGrants are time-boxed. A request without `durationDays` defaults to 90 days, and everything expires — there are no permanent grants on the gateway.",
        "operationId": "createAccessRequest",
        "security": [
          {
            "CrewSSO": ["directory:request"]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessRequest"
              },
              "example": {
                "serverId": "cosmo-snowflake-data-cloud",
                "scopes": ["mcp:read"],
                "justification": "Building the Vega corridor on-time arrival review; need read access to the governed shipment facts.",
                "durationDays": 90
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Access request created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessRequestResult"
                },
                "example": {
                  "requestId": "acr_8f21c07b",
                  "serverId": "cosmo-snowflake-data-cloud",
                  "status": "pending_manager_approval",
                  "approvers": [
                    "rhea.calder@cosmocargo.space",
                    "data-governance@cosmocargo.space"
                  ],
                  "expiresAt": "3025-02-04T00:00:00Z"
                }
              }
            }
          },
          "409": {
            "description": "The caller already has an open request or an active grant.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "CrewSSO": {
        "type": "oauth2",
        "description": "Cosmo Cargo single sign-on. The gateway exchanges the crew member's SSO session for a downstream token, so every call is made as the signed-in employee.",
        "flows": {
          "authorizationCode": {
            "authorizationUrl": "https://sso.cosmocargo.space/oauth2/v1/authorize",
            "tokenUrl": "https://sso.cosmocargo.space/oauth2/v1/token",
            "refreshUrl": "https://sso.cosmocargo.space/oauth2/v1/token",
            "scopes": {
              "confluence.content:read": "Read spaces and pages the user can view",
              "confluence.content:write": "Create pages and comments as the signed-in user",
              "devops.workitems:read": "Read work items, repos, and pipeline runs",
              "devops.workitems:write": "Create and update work items",
              "directory:read": "Read the approved server directory",
              "directory:request": "Submit access requests for a server",
              "docusign.envelopes:read": "Read envelope status and completed documents",
              "docusign.envelopes:send": "Send envelopes from approved templates only",
              "dynamics.crm:read": "Read Dataverse tables the user is licensed for",
              "dynamics.crm:write": "Create leads and update opportunities",
              "graph.calendar:write": "Read and write the signed-in user's calendar",
              "graph.mail:draft": "Create drafts in the signed-in user's mailbox",
              "graph.mail:read": "Read the signed-in user's mailbox",
              "jira.issues:read": "Read issues and sprints in projects the user can browse",
              "jira.issues:write": "Create issues, transition them, comment, and log work",
              "mcp:admin": "Administer gateway grants (platform team only)",
              "mcp:read": "Read through the crew gateway",
              "mcp:write": "Write through the crew gateway",
              "powerbi.datasets:read": "Query datasets in workspaces the user can access",
              "powerbi.reports:read": "List reports and read refresh history",
              "salesforce.crm:read": "Read Sales Cloud records the signed-in user can already see",
              "salesforce.crm:write": "Update opportunities, tasks, and activities",
              "salesforce.service:read": "Read cases, comments, and knowledge articles",
              "salesforce.service:write": "Create and update cases the agent owns or follows",
              "servicenow.incident:read": "Read incidents, changes, and CMDB records",
              "servicenow.incident:write": "Create and update incidents",
              "sharepoint.files:share": "Create sharing links inside the tenant",
              "sharepoint.sites:read": "Read sites, libraries, and files the user can open",
              "slack.channels:read": "Read public channels the user can already read",
              "slack.chat:write": "Post messages as the signed-in user",
              "teams.channels:read": "Read channels and messages the user can already read",
              "teams.channels:write": "Post messages as the signed-in user",
              "teams.chats:read": "Read private and group chats the user participates in — granted on request, not by default",
              "workday.timeoff:write": "Submit time-off requests for the caller",
              "workday.worker:read": "Read the caller's own worker data and org chart",
              "zendesk.tickets:read": "Read tickets, comments, and satisfaction data",
              "zendesk.tickets:write": "Comment on and assign tickets"
            }
          }
        }
      }
    },
    "schemas": {
      "ServerSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Stable server identifier."
          },
          "displayName": {
            "type": "string"
          },
          "domain": {
            "type": "string",
            "description": "Business domain the server belongs to."
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "description": "Streamable HTTP MCP endpoint."
          },
          "authType": {
            "type": "string",
            "enum": ["sso", "service-token"]
          },
          "toolCount": {
            "type": "integer"
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "granted": {
            "type": "boolean",
            "description": "Whether the caller holds an active grant."
          }
        }
      },
      "ServerDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ServerSummary"
          },
          {
            "type": "object",
            "properties": {
              "description": {
                "type": "string"
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              },
              "grantedTo": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Teams with an active grant."
              },
              "dataResidency": {
                "type": "string",
                "description": "Region the downstream product is pinned to."
              },
              "lastReviewed": {
                "type": "string",
                "format": "date",
                "description": "Date of the last access review."
              }
            }
          }
        ]
      },
      "ServerDirectory": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "servers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServerSummary"
            }
          }
        }
      },
      "AccessRequest": {
        "type": "object",
        "required": ["serverId", "justification"],
        "properties": {
          "serverId": {
            "type": "string",
            "description": "Server to request, from the directory."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Scopes requested. Defaults to the server's read scope."
          },
          "justification": {
            "type": "string",
            "description": "Why the caller needs it. Shown to every approver."
          },
          "durationDays": {
            "type": "integer",
            "default": 90,
            "minimum": 1,
            "maximum": 180,
            "description": "Grant lifetime in days, from 1 to 180."
          }
        }
      },
      "AccessRequestResult": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string"
          },
          "serverId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_manager_approval",
              "pending_data_owner_approval",
              "granted",
              "denied"
            ]
          },
          "approvers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Problem type URI.",
            "example": "https://mcp.cosmocargo.space/errors/scope-not-granted"
          },
          "title": {
            "type": "string",
            "example": "Scope not granted"
          },
          "status": {
            "type": "integer",
            "example": 403
          },
          "detail": {
            "type": "string",
            "example": "The tool `submit_time_off_request` requires `workday.timeoff:write`, which is not in your grant."
          },
          "requestId": {
            "type": "string",
            "example": "req_01JBQ7Z3K9"
          }
        }
      }
    }
  }
}
