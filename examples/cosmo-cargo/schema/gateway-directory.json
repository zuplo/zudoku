            "name": "authType",
            "in": "query",
            "description": "Filter by how the server authenticates.",
            "schema": {
              "type": "string",
              "enum": ["sso", "service-token"]
            }
          },
          {
            "name": "grantedOnly",
            "in": "query",
            "description": "Only return servers already granted to the caller.",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
